# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=library_db

# Server Configuration
PORT=5000

# Authentication & Security
# Required: A strong, unguessable secret used for HMAC-SHA256 JWT signing
# Example: generate with `openssl rand -hex 32` or a random 32+ character string
JWT_SECRET=your_jwt_secret_key_here

# Administrator Account Configuration
# Required for running 'npm run seed' to initialize or update the admin account
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_MEMBERSHIP_ID=ADMIN001
ADMIN_EMAIL=admin@nexus.local
